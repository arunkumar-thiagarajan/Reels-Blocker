{
  "manifest_version": 3,
  "name": "Reels Blocker",
  "version": "1.1.0",
  "description": "Block Instagram Reels and Facebook Reels to reduce doomscrolling.",
  "permissions": ["storage", "activeTab"],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*"],
      "js": ["content/instagram.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content/facebook.js"],
      "run_at": "document_idle"
    }
  ]
}
